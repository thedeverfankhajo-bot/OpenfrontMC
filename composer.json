{
  "name": "openfrontmc/openfrontmc",
  "description": "A modular territorial strategy game mode for PocketMine-MP API 5.",
  "type": "project",
  "license": "MIT",
  "require": {"php": "^8.1", "ext-json": "*", "ext-sqlite3": "*"},
  "require-dev": {"phpstan/phpstan": "^1.12"},
  "autoload": {"psr-4": {"OpenFrontMC\\": "src/OpenFrontMC/"}},
  "scripts": {"test": "php tests/run.php", "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
